# PostgreSQL / Docker Compose
# Change POSTGRES_PASSWORD before using the production compose stack.
POSTGRES_USER=market
POSTGRES_PASSWORD=change-me
POSTGRES_DB=market_changes
DATABASE_URL=postgresql+psycopg://market:change-me@postgres:5432/market_changes

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3001
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_URL=/api
FRONTEND_PORT=3001

# Pipeline
MCE_USE_LIVE=false
PIPELINE_INTERVAL_HOURS=6
PIPELINE_RUN_ON_START=true
INITIAL_PRICE_BACKFILL_DAYS=90
BENCHMARK_SYMBOLS={"US":"SPY","TW":"0050"}

# Optional live-source credentials and configuration
# ALPHA_VANTAGE_API_KEY is required for US estimates and earnings events.
ALPHA_VANTAGE_API_KEY=
# Required when SEC collection is enabled. Use a descriptive identifier with contact details.
SEC_USER_AGENT=market-changes-engine/0.1 contact@example.invalid
# Map symbols to SEC CIKs, for example: {"AAPL":"320193"}
SEC_CIK_MAP={}
# Required for FRED macro-series collection.
FRED_API_KEY=
FRED_SERIES=["DGS10","VIXCLS","T10Y2Y"]

# Optional OpenAI-compatible LLM for news classification, interpretations, and daily briefs.
# Leave LLM_BASE_URL and LLM_API_KEY blank to use deterministic fallbacks.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# News article retrieval
NEWS_MAX_AGE_DAYS=7
NEWS_CONTENT_MAX_CHARS=20000
NEWS_CONTENT_TIMEOUT_SECONDS=15
NEWS_CAMOUFOX_ENABLED=true
